PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=12h

# Seeded demo admin account — rotate or remove before production.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123

# Remote database (Turso/libSQL) — leave both unset to use a local SQLite
# file instead (good for solo/offline dev, no account needed).
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Local fallback file, only used when TURSO_DATABASE_URL is unset.
# Optional — defaults to ./data.sqlite next to server.js if unset.
# DATA_FILE=./data.sqlite
